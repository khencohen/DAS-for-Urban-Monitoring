    given-names: Khen
    affiliation: "Tel Aviv University"
repository-code: "https://github.com/khencohen/DAS-for-Urban-Monitoring"
license: MIT
version: 1.0.0
date-released: "2026-06-16"
keywords:
  - distributed acoustic sensing
  - fiber-optic sensing
  - percolation
  - urban networks
  - earthquake early warning
  - OpenStreetMap
